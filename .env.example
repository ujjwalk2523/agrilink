# ===================================================
# AgriLink Environment Configuration
# ===================================================

# Database Connection (PostgreSQL for Railway/Render/Neon or SQLite for local dev)
# For Railway / Render / Supabase: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"

# Next.js Node Environment
NODE_ENV="production"

# Application Base URL (e.g. https://agrilink.up.railway.app or https://agrilink.onrender.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
